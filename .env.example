# =============================================================================
# Anime Notif — configuration
#
# Copie ce fichier en `.env` puis renseigne les valeurs :
#     cp .env.example .env
#
# ⚠️  Le fichier `.env` contient des secrets et ne doit JAMAIS être commité.
#     Toute variable ajoutée ici doit être documentée avec son rôle,
#     son format et sa valeur par défaut.
# =============================================================================

# -----------------------------------------------------------------------------
# Général
# -----------------------------------------------------------------------------

# Fuseau horaire des conteneurs, au format IANA.
# Détermine l'horodatage des logs et l'heure d'exécution des tâches planifiées.
# Défaut : Europe/Paris
TZ=Europe/Paris


# -----------------------------------------------------------------------------
# anime-web — interface de gestion des abonnements
# -----------------------------------------------------------------------------

# Port exposé sur la machine hôte pour joindre l'interface web.
# À changer uniquement en cas de conflit avec un autre service local.
# Défaut : 3000
ANIME_WEB_HOST_PORT=3000

# Mot de passe d'accès à l'interface web, stocké sous forme de hash bcrypt.
# ⚠️  N'inscris JAMAIS le mot de passe en clair ici.
# Générer le hash :
#     docker run --rm node:22-alpine sh -c \
#       "npm i -g bcryptjs >/dev/null 2>&1 && bcryptjs '<ton-mot-de-passe>'"
# Format : chaîne commençant par $2a$ ou $2b$
ANIME_WEB_PASSWORD_HASH=

# Chemin du fichier d'état, VU DEPUIS L'INTÉRIEUR du conteneur.
# Le dossier `data/` de l'hôte y est monté en volume.
# Défaut : /data/subscriptions.json
SUBSCRIPTIONS_PATH=/data/subscriptions.json


# -----------------------------------------------------------------------------
# Notifications Discord
# -----------------------------------------------------------------------------

# Webhook utilisé pour les alertes système (service indisponible, erreurs).
# Les notifications d'épisodes utilisent le webhook défini par abonnement
# dans subscriptions.json.
# ⚠️  Un webhook Discord est un secret porteur : quiconque le possède peut
#     publier dans le salon. En cas de fuite, révoque-le et régénère-le.
# Format : https://discord.com/api/webhooks/<id>/<token>
DEFAULT_DISCORD_WEBHOOK=

#webhook pour envoyer des notif des animes sortis
DISCORD_WEBHOOK_URL=
# -----------------------------------------------------------------------------
# n8n — orchestration du scraping
# -----------------------------------------------------------------------------

# Port exposé sur la machine hôte pour l'interface n8n.
# Défaut : 5678
N8N_HOST_PORT=5678

# URL publique par laquelle n8n est joignable depuis Internet.
# n8n s'en sert pour construire les URLs affichées dans ses nœuds Webhook ;
# sans elle, il propose des URLs `localhost` inutilisables de l'extérieur.
# Ne concerne PAS les webhooks Discord.
# Format : https://n8n.exemple.fr/  (slash final inclus)
N8N_WEBHOOK_URL=

# Empêche n8n d'exiger un cookie sécurisé quand l'accès se fait en HTTP.
# À repasser à `true` une fois le HTTPS en place (étape 7).
N8N_SECURE_COOKIE=false


# -----------------------------------------------------------------------------
# worker — scraper d'épisodes
# -----------------------------------------------------------------------------

# Intervalle entre deux cycles de scraping, en minutes.
# Défaut : 30
SCRAPE_INTERVAL_MINUTES=30
