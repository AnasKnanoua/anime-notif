{
  "name": "anime-notif",
  "version": "1.0.0",
  "private": true,
  "description": "Notifications Discord automatiques à la sortie d'un nouvel épisode d'anime.",
  "main": "src/web/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/web/server.js",
    "dev": "node --watch src/web/server.js",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "format": "prettier --write src/ tests/ .github/",
    "format:check": "prettier --check src/ tests/ .github/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@prometheus-io/client": "^0.16.1",
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "vitest": "^4.1.10"
  }
}
